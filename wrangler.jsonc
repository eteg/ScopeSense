{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Um único ambiente. Localmente (npm run dev / preview) o D1 é emulado
  // pelo miniflare em .wrangler/state; o deploy usa o D1 remoto abaixo.
  "name": "reporta",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "reporta",
      "database_name": "reporta",
      "database_id": "569c3399-2e49-44e4-a011-711c900baea7",
      "migrations_dir": "db/migrations"
    }
  ]
}