# Copie para .env e preencha. O .env NUNCA vai para o Git.
#
# Regra do projeto (atualizada em 25/11): as FONTES (ingestão) só LÊEM os canais,
# com o token de usuário. Os ALERTAS são enviados por um módulo separado
# (radar/slack_alertas.py), com o token do BOT, que precisa de escrita
# (chat:write). Veja docs/BACKEND.md.

# --- Slack -------------------------------------------------------------
# ID do workspace (grupo) de teste. Começa com "T". Aparece em
# GET /fontes/slack/status depois de configurar o token, ou na URL do Slack web.
# A API recusa tokens de outro workspace.
SLACK_TEAM_ID=T0000000000

# Token de USUÁRIO (xoxp-...) do app interno, gerado em
# api.slack.com/apps > seu app > OAuth & Permissions > User OAuth Token.
# Serve para a Web API e para o servidor MCP oficial do Slack.
SLACK_USER_TOKEN=xoxp-...

# Canais do projeto monitorado, separados por vírgula (IDs começam com "C").
# Só esses canais podem ser lidos pela API.
SLACK_CHANNEL_IDS=C0000000000

# Servidor MCP oficial do Slack (não precisa mudar).
SLACK_MCP_URL=https://mcp.slack.com/mcp

# --- Slack: ESCRITA (alertas e botões) ----------------------------------
# Token do BOT (xoxb-...) com chat:write (e im:write, se for mandar DM).
SLACK_BOT_TOKEN=xoxb-...
# Token do app para Socket Mode (xapp-..., escopo connections:write): escuta
# mensagens ao vivo e os cliques nos botões, sem URL pública.
SLACK_APP_TOKEN=xapp-...
# Canal (grupo) do projeto onde o alerta é postado, marcando o responsável.
# O bot precisa ter sido convidado (/invite @Radar).
SLACK_ALERT_CHANNEL_ID=C0000000000

# --- Banco local (SQLite) -------------------------------------------------
# Tudo do Radar fica aqui: registros, alertas, decisões, obrigações, documentos
# e o cache das respostas do modelo. Sem arquivos .jsonl.
DATABASE_PATH=data/radar.db

# --- Modelo e observabilidade ---------------------------------------------
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# 1 = lê as respostas do modelo do cache (demo). Eval roda com 0.
MODO_DEMO=0

# --- Gmail -------------------------------------------------------------
# Regra: um e-mail é do projeto se
#   (a) envolve o CLIENTE (contato ou domínio em de/para/cc), em qualquer assunto; ou
#   (b) é só da EQUIPE INTERNA e cita um termo do projeto ou tem o marcador.
# Nunca a caixa inteira. Precisa de (a) ou de (b).

# (a) Cliente: contatos e/ou domínios, separados por vírgula.
GMAIL_CLIENT_CONTACTS=contato@smartfit.com.br
# Opcional: domínio corporativo do cliente (nunca gmail.com etc. nem o da equipe).
# GMAIL_CLIENT_DOMAINS=smartfit.com.br

# (b) Equipe interna + termo e/ou marcador do projeto.
GMAIL_PARTICIPANTS=gestor@eteg.com.br,dev@eteg.com.br
GMAIL_PROJECT_TERMS=SmartFit
# GMAIL_LABEL=projeto-smartfit

# Credencial (escolha uma):
# 1) Recomendado: rode `python -m radar.fontes.gmail.autorizar` uma vez.
#    Precisa do JSON do cliente OAuth (Desktop) neste caminho:
GMAIL_CLIENT_SECRET_FILE=.secrets/gmail_client_secret.json
#    e salva o token com renovação automática aqui:
GMAIL_TOKEN_FILE=.secrets/gmail_token.json
# 2) Teste rápido: access token (ya29...), expira em ~1 hora e não renova.
#    Se o arquivo de token existir, ele tem prioridade.
# GMAIL_ACCESS_TOKEN=ya29...

# Servidor MCP oficial do Gmail (não precisa mudar).
GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
