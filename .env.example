# Copie para .env e preencha. O .env NUNCA vai para o Git.
#
# Regra do projeto: o Radar SÓ LÊ os canais. Configure no app do Slack
# apenas os escopos de LEITURA listados no README.

# --- Slack -------------------------------------------------------------
# ID do workspace (grupo) de teste. Começa com "T". Aparece em
# GET /fontes/slack/status depois de configurar o token, ou na URL do Slack web.
# A API recusa tokens de outro workspace.
SLACK_TEAM_ID=T0000000000

# Token de USUÁRIO (xoxp-...) do app interno, gerado em
# api.slack.com/apps > seu app > OAuth & Permissions > User OAuth Token.
# Serve para a Web API e para o servidor MCP oficial do Slack.
SLACK_USER_TOKEN=xoxp-...

# Canais do projeto monitorado, separados por vírgula (IDs começam com "C").
# Só esses canais podem ser lidos pela API.
SLACK_CHANNEL_IDS=C0000000000

# Servidor MCP oficial do Slack (não precisa mudar).
SLACK_MCP_URL=https://mcp.slack.com/mcp
